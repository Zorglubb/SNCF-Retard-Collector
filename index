<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Prochain Train</title>
  <style>
    :root {
      --bg: #0f172a;
      --card-bg: #1e293b;
      --text: #f8fafc;
      --muted: #94a3b8;
      --accent: #38bdf8;
      --success: #4ade80;
      --warning: #f87171;
    }
    body {
      margin: 0;
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      background: var(--bg);
      font-family: system-ui, -apple-system, sans-serif;
      color: var(--text);
      padding: 16px;
      box-sizing: border-box;
    }
    .card {
      background: var(--card-bg);
      padding: 28px;
      border-radius: 24px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.5);
      width: 100%;
      max-width: 360px;
      text-align: center;
    }
    .destination {
      font-size: 1.1rem;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-bottom: 8px;
    }
    .target-city {
      font-size: 1.8rem;
      font-weight: 700;
      color: var(--accent);
      margin-bottom: 24px;
    }
    .depart-label {
      font-size: 0.9rem;
      color: var(--muted);
      margin-bottom: 4px;
    }
    .time {
      font-size: 4rem;
      font-weight: 800;
      line-height: 1;
      margin-bottom: 12px;
      font-variant-numeric: tabular-nums;
    }
    .badge {
      display: inline-block;
      padding: 6px 14px;
      border-radius: 9999px;
      font-weight: 600;
      font-size: 0.95rem;
      margin-bottom: 24px;
    }
    .badge.on-time { background: rgba(74, 222, 128, 0.15); color: var(--success); }
    .badge.late { background: rgba(248, 113, 113, 0.15); color: var(--warning); }
    
    .meta {
      font-size: 0.9rem;
      color: var(--muted);
      margin-bottom: 24px;
    }
    .btn-group {
      display: flex;
      gap: 12px;
    }
    button {
      flex: 1;
      background: #334155;
      border: none;
      color: var(--text);
      padding: 12px;
      border-radius: 12px;
      font-weight: 600;
      cursor: pointer;
      transition: background 0.2s;
    }
    button:active {
      background: #475569;
    }
  </style>
</head>
<body>

  <div class="card">
    <div class="destination">Direction</div>
    <div class="target-city" id="direction">Chargement...</div>

    <div class="depart-label">Prochain départ</div>
    <div class="time" id="depart">--:--</div>

    <div id="retard-badge" class="badge">--</div>

    <div class="meta">
      Durée estimée : <strong id="duree" style="color: var(--text);">--</strong>
    </div>

    <div class="btn-group">
      <button onclick="fetchTrain()">🔄 Actualiser</button>
      <button onclick="toggleDirection()">⇄ Inverser</button>
    </div>
  </div>

  <script>
    let overrideDirection = null;

    async function fetchTrain() {
      const dirElem = document.getElementById('direction');
      const timeElem = document.getElementById('depart');
      const badgeElem = document.getElementById('retard-badge');
      const dureeElem = document.getElementById('duree');

      badgeElem.textContent = 'Actualisation...';
      badgeElem.className = 'badge';

      let url = '/api';
      if (overrideDirection) {
        url += `?dir=${overrideDirection}`;
      }

      try {
        const res = await fetch(url);
        const data = await res.json();

        if (data.error) {
          dirElem.textContent = "Aucun train";
          timeElem.textContent = "--:--";
          badgeElem.textContent = data.error;
          return;
        }

        dirElem.textContent = data.destination;
        timeElem.textContent = data.depart;
        badgeElem.textContent = data.retard;
        badgeElem.className = data.retard === "À l'heure" ? 'badge on-time' : 'badge late';
        dureeElem.textContent = data.duree;

      } catch (err) {
        badgeElem.textContent = 'Erreur de chargement';
        badgeElem.className = 'badge late';
      }
    }

    function toggleDirection() {
      const currentDir = document.getElementById('direction').textContent.toLowerCase();
      overrideDirection = currentDir.includes('bourges') ? 'vierzon' : 'bourges';
      fetchTrain();
    }

    // Chargement initial
    fetchTrain();
  </script>
</body>
</html>
